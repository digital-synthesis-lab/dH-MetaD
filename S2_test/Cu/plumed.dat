LOAD FILE=PairEntropy.cpp

PAIRENTROPY ...
 LABEL=s2
 ATOMS=1-500
 MAXR=0.7
 SIGMA=0.0125
... PAIRENTROPY

METAD ...
 LABEL=metad
 ARG=s2
 SIGMA=0.1
 HEIGHT=9.649
 BIASFACTOR=30
 TEMP=3000.0
 PACE=500
 GRID_MIN=-15
 GRID_MAX=-1
 GRID_BIN=500
 CALC_RCT
... METAD

PRINT STRIDE=500  ARG=* FILE=results/COLVAR
